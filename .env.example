# URL de la base de datos Prisma (PostgreSQL en producción).
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# Ejemplos:
#   Neon:      postgresql://user:pass@ep-xxx.region.aws.neon.tech/cedersa?sslmode=require
#   Supabase:  postgresql://postgres:pass@db.xxxxx.supabase.co:5432/postgres
#   Local:     postgresql://postgres:postgres@localhost:5432/cedersa
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# NextAuth.js
NEXTAUTH_SECRET="generar-un-secreto-aleatorio-con-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
